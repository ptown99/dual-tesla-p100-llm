[Unit]
Description=Google Gemma 4 31B Dense Instruct (Dual P100 - Tensor Parallel - 128k Context Q4_0 KV)
After=network.target homelab-tuning.service disable-acs-p2p.service

[Service]
TimeoutStopSec=3s
KillMode=mixed
SendSIGKILL=yes
Environment=GOMP_CPU_AFFINITY=0,1,2,3
Type=simple
User=mimi
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
Environment=CUDA_VISIBLE_DEVICES=1,2
ExecStart=/opt/llama.cpp/build/bin/llama-server \
  --model /opt/models/phase3-ssd/google_gemma-4-31B-it-Q4_K_M.gguf \
  --mmproj /opt/models/phase3-ssd/mmproj-google_gemma-4-31B-it-f16.gguf \
  --alias mae-gemma4-31b-it \
  --fit off \
  --host 0.0.0.0 --port 8002 \
  --jinja \
  -sm tensor \
  -ngl 999 \
  -fa on \
  -c 131072 \
  -ctk q4_0 -ctv q4_0 \
  -b 2048 -ub 512 -np 1 \
  --cache-prompt \
  --cache-reuse 64 \
  --threads 4 --threads-batch 6 \
  --cont-batching --no-warmup
Restart=no
RestartSec=3

[Install]
WantedBy=multi-user.target
