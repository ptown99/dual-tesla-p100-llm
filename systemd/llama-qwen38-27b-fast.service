[Unit]
Description=Qwen 3.8 27B STEM Tutor (Dual P100 - Curated P100 sm_60 Tensor Parallel - 210k Context Q8_0 KV + MTP 3-Draft)
After=network.target homelab-tuning.service disable-acs-p2p.service

[Service]
TimeoutStopSec=15s
KillMode=mixed
SendSIGKILL=yes
Environment=GOMP_CPU_AFFINITY=0,1,2,3
Type=simple
User=mimi
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
Environment=CUDA_VISIBLE_DEVICES=1,2
Environment=GGML_CUDA_GRAPHS_PRE_VOLTA=3
Environment=LLAMA_SPEC_SAMPLE_TEMP=1.0
Environment=LLAMA_SPEC_DRAFT_TOPK=20
ExecStart=/opt/p100-llama-cpp/llama.cpp/build/bin/llama-server \
  --model /opt/models/phase4/Qwen3.8-27B-UD-IQ4_XS.gguf \
  --alias mae-engineering-tutor \
  --fit off \
  --host 0.0.0.0 --port 8002 \
  -sm tensor \
  -ngl 999 \
  -fa on \
  -c 215040 \
  -ctk q8_0 -ctv q8_0 \
  -b 32768 -ub 512 -np 1 \
  --spec-type draft-mtp --spec-draft-n-max 3 --spec-draft-p-min 0.18 \
  -ngld 999 -ctkd q8_0 -ctvd q8_0 \
  --jinja --temp 0.0 --top-k 20 --top-p 1.0 --min-p 0.0 \
  --slots --slot-save-path /var/cache/llama-kv \
  --cache-reuse 64 \
  --threads 4 --threads-batch 4 \
  --no-mmap \
  --cont-batching --no-warmup
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
