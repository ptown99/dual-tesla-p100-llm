+template <> struct mmvq_x<GGML_TYPE_IQ2_S> {
+    static constexpr int vdr = VDR_IQ2_S_Q8_1_MMVQ;
+    static __device__ __forceinline__ float f(const void * vbq, const block_q8_1 * bq8_1, const int & kbx, const int & iqs) {
