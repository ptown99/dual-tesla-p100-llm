+static llama_token fast_argmax_avx2(const float * logits, int n_vocab) {
+    if (n_vocab <= 0 || !logits) return LLAMA_TOKEN_NULL;
+    int max_i = 0;
+    float max_val = logits[0];
+
+    __m256 v_max = _mm256_set1_ps(-INFINITY);
+    __m256i v_cur_idx = _mm256_set_epi32(7, 6, 5, 4, 3, 2, 1, 0);
+    __m256i v_best_idx = v_cur_idx;
+    __m256i v_step = _mm256_set1_epi32(8);
+
+    int i = 0;
+    for (; i + 7 < n_vocab; i += 8) {
+        __m256 v = _mm256_loadu_ps(logits + i);
+        __m256 mask = _mm256_cmp_ps(v, v_max, _CMP_GT_OQ);
+        v_max = _mm256_max_ps(v_max, v);
+        v_best_idx = _mm256_castps_si256(_mm256_blendv_ps(_mm256_castsi256_ps(v_best_idx), _mm256_castsi256_ps(v_cur_idx), mask));
+        v_cur_idx = _mm256_add_epi32(v_cur_idx, v_step);
+    }
+
+    alignas(32) float f_vals[8];
+    alignas(32) int32_t f_indices[8];
+    _mm256_storeu_ps(f_vals, v_max);
+    _mm256_storeu_si256((__m256i*)f_indices, v_best_idx);
+
+    for (int k = 0; k < 8; ++k) {
+        if (f_vals[k] > max_val) {
+            max_val = f_vals[k];
+            max_i = f_indices[k];
+        }
+    }
+    for (; i < n_vocab; ++i) {
+        if (logits[i] > max_val) {
+            max_val = logits[i];
+            max_i = i;
+        }
+    }
+    return max_i;
+}
+#else
