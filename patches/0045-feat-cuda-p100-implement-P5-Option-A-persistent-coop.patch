+
+// mul_mat_vec_q row computation: 1 warp computes an entire output row from row & y.
+template <ggml_type type>
+__device__ __forceinline__ float mmvq_row(const void * row, const block_q8_1 * y, const int ncols_x, const int lane) {
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = mmvq_x<type>::vdr;
+    constexpr int nwarps = 4;
+    const int blocks_per_row_x = ncols_x / qk;
+    constexpr int blocks_per_iter = vdr * nwarps * WARP_SIZE / qi;
+    float part[nwarps];
+#pragma unroll
+    for (int w = 0; w < nwarps; w++) {
+        const int tid = WARP_SIZE * w + lane;
+        float tmp = 0.0f;
+        for (int kbx = tid / (qi / vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+            const int kby = kbx * (qk / QK8_1);
+            const int kqs = vdr * (tid % (qi / vdr));
+            tmp += mmvq_x<type>::f(row, &y[kby], kbx, kqs);
+        }
+        part[w] = tmp;
+    }
+    float tmp = part[0];
+#pragma unroll
+    for (int l = 0; l < nwarps - 1; ++l) {
+        tmp += part[l + 1];
+    }
+    return warp_reduce_sum<WARP_SIZE>(tmp);
+}
+
+static __device__ __noinline__ float dot_mmvq_row(const void * row, const block_q8_1 * y, int ncols_x, int type, int lane) {
+    switch (type) {
+        case GGML_TYPE_Q8_0:    return mmvq_row<GGML_TYPE_Q8_0>(row, y, ncols_x, lane);
+        case GGML_TYPE_Q4_K:    return mmvq_row<GGML_TYPE_Q4_K>(row, y, ncols_x, lane);
+        case GGML_TYPE_Q5_K:    return mmvq_row<GGML_TYPE_Q5_K>(row, y, ncols_x, lane);
+        case GGML_TYPE_Q6_K:    return mmvq_row<GGML_TYPE_Q6_K>(row, y, ncols_x, lane);
+        case GGML_TYPE_Q3_K:    return mmvq_row<GGML_TYPE_Q3_K>(row, y, ncols_x, lane);
+        case GGML_TYPE_Q2_K:    return mmvq_row<GGML_TYPE_Q2_K>(row, y, ncols_x, lane);
+        case GGML_TYPE_IQ4_XS:  return mmvq_row<GGML_TYPE_IQ4_XS>(row, y, ncols_x, lane);
+        case GGML_TYPE_IQ3_S:   return mmvq_row<GGML_TYPE_IQ3_S>(row, y, ncols_x, lane);
+        case GGML_TYPE_IQ3_XXS: return mmvq_row<GGML_TYPE_IQ3_XXS>(row, y, ncols_x, lane);
+        case GGML_TYPE_IQ2_XS:  return mmvq_row<GGML_TYPE_IQ2_XS>(row, y, ncols_x, lane);
+        case GGML_TYPE_IQ2_S:   return mmvq_row<GGML_TYPE_IQ2_S>(row, y, ncols_x, lane);
+        default:                return 0.0f;
+    }
+}
+
+// ---------------- parameters & kernel ----------------
+
+struct qwen27b_ffn_params {
+    ggml_cuda_p60_mega_qwen27b_ffn_args a;
+    float * act_f32;
+    unsigned * bar;
+    unsigned base;
+};
+
+union smem_buffer {
+    struct {
+        block_q8_1 y_norm[D / QK8_1];    // 160 * 36 B = 5,760 B
+        float red[NW];                   // 16 floats = 64 B
+        float scal[1];                   // 1 float = 4 B
+    } phase0;
+    struct {
+        block_q8_1 act_q8_1[17408 / QK8_1]; // up to 544 * 36 B = 19,584 B
+    } phase2;
+};
+
+__global__ void __launch_bounds__(NT, 1) p60_mega_qwen27b_ffn_kernel(qwen27b_ffn_params P) {
+    const ggml_cuda_p60_mega_qwen27b_ffn_args & A = P.a;
+    extern __shared__ char smem_raw[];
+    smem_buffer & sb = *(smem_buffer *) smem_raw;
+
+    const int lane = threadIdx.x & 31;
+    const int warp = threadIdx.x >> 5;
+    const int gw = blockIdx.x * NW + warp;
+    const int nwg = gridDim.x * NW;
+    unsigned target = P.base;
+
+
+
+    // Initialize IQ grid tables in shared memory as needed
+    if (A.gate_type == GGML_TYPE_IQ2_XS || A.up_type == GGML_TYPE_IQ2_XS || A.down_type == GGML_TYPE_IQ2_XS) {
+        iq2xs_grid_smem_init(threadIdx.x, blockDim.x);
+    }
+    if (A.gate_type == GGML_TYPE_IQ2_S || A.up_type == GGML_TYPE_IQ2_S || A.down_type == GGML_TYPE_IQ2_S) {
+        iq2s_grid_smem_init(threadIdx.x, blockDim.x);
+    }
+    if (A.gate_type == GGML_TYPE_IQ3_XXS || A.up_type == GGML_TYPE_IQ3_XXS || A.down_type == GGML_TYPE_IQ3_XXS) {
+        iq3xxs_grid_smem_init(threadIdx.x, blockDim.x);
+    }
+    if (A.gate_type == GGML_TYPE_IQ3_S || A.up_type == GGML_TYPE_IQ3_S || A.down_type == GGML_TYPE_IQ3_S) {
+        iq3s_grid_smem_init(threadIdx.x, blockDim.x);
+    }
+
+    // Phase 0: RMSNorm on x_in (D = 5120) with post_norm, then quantize into phase0.y_norm
+    {
+        float xv[10];
+        float ss = 0.f;
+#pragma unroll
+        for (int j = 0; j < 10; j++) {
+            const int k = threadIdx.x + j * NT;
+            xv[j] = __ldg(A.x_in + k);
+            ss += xv[j] * xv[j];
+        }
+        ss = wsum(ss);
+        if (lane == 0) {
+            sb.phase0.red[warp] = ss;
+        }
+        __syncthreads();
+        if (warp == 0) {
+            float v = lane < NW ? sb.phase0.red[lane] : 0.f;
+            v = wsum(v);
+            if (lane == 0) {
+                sb.phase0.scal[0] = rsqrtf(v / (float) D + A.eps_norm);
+            }
+        }
+        __syncthreads();
+        const float sc = sb.phase0.scal[0];
+
+        // Quantize normed input directly into phase0.y_norm in shared memory (160 blocks)
+        for (int b = warp; b < D / QK8_1; b += NW) {
+            const int k = b * QK8_1 + lane;
+            const float xi = __ldg(A.x_in + k) * sc * __ldg(A.post_norm + k);
+            quantize_block(xi, &sb.phase0.y_norm[b], lane);
+        }
+        __syncthreads();
+    }
+
+    // Phase 1: Gate & Up Projections across all FF rows
+    const int FF = A.ff;
+    for (int m = gw; m < FF; m += nwg) {
+        const char * gate_row = (const char *) A.gate + (size_t) m * A.gate_stride;
+        const char * up_row   = (const char *) A.up   + (size_t) m * A.up_stride;
+        const float g = dot_mmvq_row(gate_row, sb.phase0.y_norm, D, A.gate_type, lane);
+        const float u_val = dot_mmvq_row(up_row, sb.phase0.y_norm, D, A.up_type, lane);
+        if (lane == 0) {
+            P.act_f32[m] = silu_f(g) * u_val;
+        }
+    }
+
+    // Barrier 1: ensure all warps have finished computing and writing P.act_f32
+    grid_sync(P.bar, target);
+
+    // Phase 1.5: Quantize P.act_f32 into shared memory phase2.act_q8_1
+    const int n_blocks_ff = FF / QK8_1;
+    for (int b = warp; b < n_blocks_ff; b += NW) {
+        const int idx = b * QK8_1 + lane;
+        const float xi = P.act_f32[idx];
+        quantize_block(xi, &sb.phase2.act_q8_1[b], lane);
+    }
+    __syncthreads();
+
+    // Phase 2: Down Projection across all D = 5,120 rows
+    for (int r = gw; r < D; r += nwg) {
+        const char * down_row = (const char *) A.down + (size_t) r * A.down_stride;
+        const float d_val = dot_mmvq_row(down_row, sb.phase2.act_q8_1, FF, A.down_type, lane);
+        if (lane == 0) {
+            A.x_out[r] = A.add_residual ? (__ldg(A.x_in + r) + d_val) : d_val;
+        }
+    }
+
+    // Down projection complete - no grid sync needed at kernel exit
+}
+
+static unsigned * mega_bar(ggml_backend_cuda_context & ctx) {
+    if (ctx.p60_mega_bar == nullptr) {
+        ggml_cuda_set_device(ctx.device);
+        CUDA_CHECK(cudaMalloc(&ctx.p60_mega_bar, sizeof(unsigned)));
+        CUDA_CHECK(cudaMemset(ctx.p60_mega_bar, 0, sizeof(unsigned)));
+        ctx.p60_mega_epoch = 0;
+    }
+    return ctx.p60_mega_bar;
+}
+
+template <typename KP>
+void mega_launch(ggml_backend_cuda_context & ctx, void (*kernel)(const KP), KP & kp, int n_barriers) {
+    ggml_cuda_set_device(ctx.device);
+    const int nblk = ggml_cuda_info().devices[ctx.device].nsm;
+    kp.bar  = mega_bar(ctx);
+    kp.base = ctx.p60_mega_epoch;
+    void * args[] = { &kp };
+    CUDA_CHECK(cudaLaunchCooperativeKernel((const void *) kernel, dim3(nblk), dim3(NT), args, sizeof(smem_buffer), ctx.stream()));
+    ctx.p60_mega_epoch += (unsigned) (n_barriers * nblk);
+}
+
+} // namespace
+
+static float * mega_act(ggml_backend_cuda_context & ctx) {
+    if (ctx.p60_mega_act == nullptr) {
+        ggml_cuda_set_device(ctx.device);
+        CUDA_CHECK(cudaMalloc(&ctx.p60_mega_act, 17408 * sizeof(float)));
+    }
+    return ctx.p60_mega_act;
+}
+
+void ggml_cuda_p60_mega_qwen27b_ffn(ggml_backend_cuda_context & ctx, const ggml_cuda_p60_mega_qwen27b_ffn_args & args) {
+    ggml_cuda_set_device(ctx.device);
+    qwen27b_ffn_params kp = {};
+    kp.a       = args;
+    kp.act_f32 = mega_act(ctx);
+    mega_launch(ctx, p60_mega_qwen27b_ffn_kernel, kp, 1);
+}
diff --git a/ggml/src/ggml-cuda/p60-mega-qwen27b-ffn.cuh b/ggml/src/ggml-cuda/p60-mega-qwen27b-ffn.cuh
new file mode 100644
index 0000000..93c7d9e
--- /dev/null
+++ b/ggml/src/ggml-cuda/p60-mega-qwen27b-ffn.cuh
@@ -0,0 +1,38 @@
+#pragma once
+
+#include "common.cuh"
+
+// Megakernel for Qwen 3.8 27B SwiGLU Dense FFN on sm_60 (GP100)
+// Fuses:
+//   1. RMSNorm (D = 5120) with post_attention_norm.weight
+//   2. FFN Gate projection (FF x 5,120)
+//   3. FFN Up projection (FF x 5,120)
+//   4. SwiGLU activation: act = silu(gate) * up
+//   5. FFN Down projection (5,120 x FF)
+//   6. In-place residual addition (if add_residual=true)
+// All in 1 cooperative persistent kernel launch across 56 SMs.
+
+struct ggml_cuda_p60_mega_qwen27b_ffn_args {
+    float eps_norm;
+    const float * x_in;      // [D = 5120] input residual
+    float * x_out;           // [D = 5120] output tensor
+    int il;                  // layer index
+    int ff;                  // FF dimension (8704 for TP=2, 17408 for single-GPU)
+    bool add_residual;       // whether to accumulate residual directly
+    const float * post_norm; // [D = 5120] post_attention_norm.weight
+
+    const void * gate;
+    size_t gate_stride;
+    int gate_type;
+
+    const void * up;
+    size_t up_stride;
+    int up_type;
+
+    const void * down;
+    size_t down_stride;
+    int down_type;
+    size_t down_block_size;
+};
+
+void ggml_cuda_p60_mega_qwen27b_ffn(ggml_backend_cuda_context & ctx, const ggml_cuda_p60_mega_qwen27b_ffn_args & args);
diff --git a/ggml/src/ggml-cuda/p60_qwen27b_ffn_matcher.inc b/ggml/src/ggml-cuda/p60_qwen27b_ffn_matcher.inc
new file mode 100644
index 0000000..f4c5339
--- /dev/null
+++ b/ggml/src/ggml-cuda/p60_qwen27b_ffn_matcher.inc
@@ -0,0 +1,156 @@
+#include <algorithm>
+#include <cstring>
+#include <cstdio>
+
+static bool p60_is_weight(const ggml_tensor * t, int il, const char * suffix) {
+    if (t == nullptr || t->name[0] == 0) {
+        return false;
+    }
+    char buf[128];
+    snprintf(buf, sizeof(buf), "blk.%d.%s", il, suffix);
+    return strcmp(t->name, buf) == 0;
+}
+
+static const ggml_tensor * p60_view_root(const ggml_tensor * t) {
+    while (t != nullptr && t->view_src != nullptr) {
+        t = t->view_src;
+    }
+    return t;
+}
+
+static bool p60_range_private(const ggml_cgraph * g, int beg, int end, const ggml_tensor * keep) {
+    for (int k = beg; k <= end; k++) {
+        const ggml_tensor * t = g->nodes[k];
+        if (t != keep && (t->flags & GGML_TENSOR_FLAG_OUTPUT)) {
+            return false;
+        }
+    }
+    const int lim = std::min(g->n_nodes, end + 400);
+    for (int k = end + 1; k < lim; k++) {
+        for (int j = 0; j < GGML_MAX_SRC; j++) {
+            const ggml_tensor * src = g->nodes[k]->src[j];
+            if (src == nullptr) {
+                continue;
+            }
+            const ggml_tensor * r = p60_view_root(src);
+            if (r == keep || p60_view_root(keep) == r) {
+                continue;
+            }
+            for (int m = beg; m <= end; m++) {
+                if (g->nodes[m] == r || g->nodes[m] == src) {
+                    return false;
+                }
+            }
+        }
+    }
+    return true;
+}
+
+static int p60_try_mega_qwen27b_ffn(ggml_backend_cuda_context * ctx, ggml_cgraph * g, int i, bool dry = false) {
+    const ggml_tensor * norm = g->nodes[i];
+    if (norm->op != GGML_OP_RMS_NORM || i + 5 >= g->n_nodes) {
+        return 0;
+    }
+    const ggml_tensor * nmul = g->nodes[i + 1];
+    if (nmul->op != GGML_OP_MUL || nmul->src[0] != norm || nmul->src[1] == nullptr) {
+        return 0;
+    }
+    int il = -1;
+    if (sscanf(nmul->src[1]->name, "blk.%d.post_attention_norm.weight", &il) != 1 ||
+        !p60_is_weight(nmul->src[1], il, "post_attention_norm.weight")) {
+        return 0;
+    }
+
+    const int64_t T = norm->src[0]->ne[1];
+    if (T != 1) {
+        return 0;
+    }
+
+    const ggml_tensor * ffn_gate = g->nodes[i + 2];
+    const ggml_tensor * ffn_up   = g->nodes[i + 3];
+    const ggml_tensor * swiglu   = g->nodes[i + 4];
+    const ggml_tensor * ffn_down = g->nodes[i + 5];
+
+    if (ffn_gate->op != GGML_OP_MUL_MAT || !p60_is_weight(ffn_gate->src[0], il, "ffn_gate.weight")) return 0;
+    if (ffn_up->op   != GGML_OP_MUL_MAT || !p60_is_weight(ffn_up->src[0],   il, "ffn_up.weight"))   return 0;
+    if (swiglu->op != GGML_OP_GLU || ggml_get_glu_op(swiglu) != GGML_GLU_OP_SWIGLU ||
+        swiglu->src[0] != ffn_gate || swiglu->src[1] != ffn_up) return 0;
+    if (ffn_down->op != GGML_OP_MUL_MAT || !p60_is_weight(ffn_down->src[0], il, "ffn_down.weight") || ffn_down->src[1] != swiglu) return 0;
+
+    const ggml_tensor * gate_w = ffn_gate->src[0];
+    const ggml_tensor * up_w   = ffn_up->src[0];
+    const ggml_tensor * down_w = ffn_down->src[0];
+
+    const int64_t D  = gate_w->ne[0];
+    const int64_t FF = gate_w->ne[1];
+
+    if (D != 5120) return 0;
+    if (FF != 8704 && FF != 17408) return 0;
+    if (up_w->ne[0] != D || up_w->ne[1] != FF) return 0;
+    if (down_w->ne[0] != FF || down_w->ne[1] != D) return 0;
+
+    auto is_supported = [](ggml_type t) {
+        return t == GGML_TYPE_IQ4_XS || t == GGML_TYPE_IQ3_S || t == GGML_TYPE_IQ3_XXS ||
+               t == GGML_TYPE_IQ2_XS || t == GGML_TYPE_IQ2_S || t == GGML_TYPE_Q3_K ||
+               t == GGML_TYPE_Q4_K   || t == GGML_TYPE_Q5_K  || t == GGML_TYPE_Q8_0;
+    };
+
+    if (!is_supported(gate_w->type) || !is_supported(up_w->type) || !is_supported(down_w->type)) {
+        return 0;
+    }
+
+    // Check if there is an in-graph ADD right after down (e.g. single-GPU/layer split mode)
+    bool has_add = false;
+    if (i + 6 < g->n_nodes) {
+        const ggml_tensor * add = g->nodes[i + 6];
+        if (add->op == GGML_OP_ADD &&
+            ((add->src[0] == ffn_down && add->src[1] == norm->src[0]) ||
+             (add->src[1] == ffn_down && add->src[0] == norm->src[0]))) {
+            has_add = true;
+        }
+    }
+
+    const int end_node = has_add ? (i + 6) : (i + 5);
+    const ggml_tensor * out_tensor = has_add ? g->nodes[i + 6] : ffn_down;
+
+    if (!p60_range_private(g, i, end_node, out_tensor)) {
+        return 0;
+    }
+
+    static bool logged[65] = {};
+    if (!dry && il >= 0 && il < 65 && !logged[il]) {
+        logged[il] = true;
+        fprintf(stderr, "p60-qwen27b-ffn matched layer %2d (nodes %4d..%4d, FF=%d, TP=%s): gate=%-7s up=%-7s down=%-7s\n",
+            il, i, end_node, (int)FF, has_add ? "off" : "on",
+            ggml_type_name(gate_w->type), ggml_type_name(up_w->type), ggml_type_name(down_w->type));
+    }
+
+    if (dry) {
+        return end_node - i;
+    }
+
+    ggml_cuda_p60_mega_qwen27b_ffn_args a = {};
+    memcpy(&a.eps_norm, norm->op_params, sizeof(float));
+    a.x_in = (const float *) norm->src[0]->data;
+    a.x_out = (float *) out_tensor->data;
+    a.il = il;
+    a.ff = (int) FF;
+    a.add_residual = has_add;
+    a.post_norm = (const float *) nmul->src[1]->data;
+
+    a.gate = gate_w->data;
+    a.gate_stride = gate_w->nb[1];
+    a.gate_type = gate_w->type;
+
+    a.up = up_w->data;
+    a.up_stride = up_w->nb[1];
+    a.up_type = up_w->type;
+
+    a.down = down_w->data;
+    a.down_stride = down_w->nb[1];
+    a.down_type = down_w->type;
+    a.down_block_size = ggml_type_size(down_w->type);
+
+    ggml_cuda_p60_mega_qwen27b_ffn(*ctx, a);
+    return end_node - i;
+}
