+#include "p60-mega-qwen27b-ffn.cuh"
+#include "vecdotq.cuh"
+#include "unary.cuh"
+
+#include <cstdio>
+
+// Persistent single-token megakernel for Qwen 3.8 27B dense SwiGLU FFN on sm_60 (GP100).
+// Fuses nodes [60..66] (RMS norm, post-norm mul, gate projection, up projection, SwiGLU,
+// down projection, and in-place residual add) into 1 persistent cooperative kernel launch across 56 SMs.
+// Vectorized via MMVQ block_q8_1 dot products: 16-byte coalesced loads, hardware DP4A,
+// zero shared memory bank conflicts, no down-projection tiling, and only 2 grid barriers.
+
+namespace {
+
+constexpr int NT = 512, NW = NT / 32;
+constexpr int D = 5120;
+// FF is dynamic (8704 for TP, 17408 for single-GPU)
+
+// ---------------- device helpers ----------------
+
+__device__ __forceinline__ void grid_sync(unsigned * bar, unsigned & target) {
+    __syncthreads();
+    if (threadIdx.x == 0) {
+        target += gridDim.x;
+        __threadfence();
+        atomicAdd(bar, 1u);
+        while ((int) (*(volatile unsigned *) bar - target) < 0) {}
+        __threadfence();
+    }
+    __syncthreads();
+}
+
+__device__ __forceinline__ float wsum(float v) {
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) {
+        v += __shfl_xor_sync(0xffffffff, v, o);
+    }
+    return v;
+}
+
+__device__ __forceinline__ float silu_f(float v) {
+    return ggml_cuda_op_silu_single(v);
+}
+
+// Quantize one 32-value block into block_q8_1 by one warp (lane = value index 0..31)
+__device__ __forceinline__ void quantize_block(const float xi, block_q8_1 * yb, const int lane) {
+    float amax = fabsf(xi);
+    float sum = xi;
+    amax = warp_reduce_max<QK8_1>(amax);
+    sum  = warp_reduce_sum<QK8_1>(sum);
+    const float  d = amax / 127.0f;
+    const int8_t q = amax == 0.0f ? 0 : roundf(xi / d);
+    yb->qs[lane] = q;
+    if (lane == 0) {
+        yb->ds = make_half2(d, sum);
+    }
+}
+
+// ---------------- MMVQ mappings to vecdotq.cuh ----------------
+
+template <ggml_type type> struct mmvq_x;
+
+template <> struct mmvq_x<GGML_TYPE_Q8_0> {
+    static constexpr int vdr = VDR_Q8_0_Q8_1_MMVQ;
+    static __device__ __forceinline__ float f(const void * vbq, const block_q8_1 * bq8_1, const int & kbx, const int & iqs) {
+        return vec_dot_q8_0_q8_1(vbq, bq8_1, kbx, iqs);
+    }
+};
+
+template <> struct mmvq_x<GGML_TYPE_Q4_K> {
+    static constexpr int vdr = VDR_Q4_K_Q8_1_MMVQ;
+    static __device__ __forceinline__ float f(const void * vbq, const block_q8_1 * bq8_1, const int & kbx, const int & iqs) {
+        return vec_dot_q4_K_q8_1(vbq, bq8_1, kbx, iqs);
+    }
+};
+
