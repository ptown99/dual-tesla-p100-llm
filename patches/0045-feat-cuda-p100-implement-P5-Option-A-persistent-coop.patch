+static void fast_top_k_extract(const float * logits, int n_vocab, int k, std::vector<llama_token_data> & out) {
+    if (n_vocab <= 0 || !logits || k <= 0) {
+        out.clear();
+        return;
+    }
+    struct Cand {
+        float logit;
+        llama_token id;
+        bool operator>(const Cand & other) const { return logit > other.logit; }
+    };
+
+    constexpr int MAX_HEAP = 256;
+    if (k > MAX_HEAP) k = MAX_HEAP;
+
+    Cand heap[MAX_HEAP];
+    int heap_size = 0;
+    float min_val = -INFINITY;
+
+    for (int i = 0; i < n_vocab; ++i) {
+        const float val = logits[i];
+        if (heap_size < k) {
+            heap[heap_size] = { val, (llama_token)i };
+            heap_size++;
+            if (heap_size == k) {
+                std::make_heap(heap, heap + k, std::greater<Cand>());
+                min_val = heap[0].logit;
+            }
+        } else if (val > min_val) {
+            std::pop_heap(heap, heap + k, std::greater<Cand>());
+            heap[k - 1] = { val, (llama_token)i };
+            std::push_heap(heap, heap + k, std::greater<Cand>());
+            min_val = heap[0].logit;
+        }
+    }
+
+    std::sort_heap(heap, heap + heap_size, std::greater<Cand>());
+
+    out.resize(heap_size);
+    for (int i = 0; i < heap_size; ++i) {
+        out[i] = llama_token_data{ heap[i].id, heap[i].logit, 0.0f };
+    }
+}
