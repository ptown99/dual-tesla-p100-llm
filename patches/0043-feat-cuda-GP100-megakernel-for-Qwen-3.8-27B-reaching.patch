+    }
+
+#pragma unroll
+    for (int r = 0; r < R; r++) {
+#pragma unroll
+        for (int o = 16; o > 0; o >>= 1) {
+            sum_up[r]   += __shfl_xor_sync(0xFFFFFFFF, sum_up[r], o);
+            sum_gate[r] += __shfl_xor_sync(0xFFFFFFFF, sum_gate[r], o);
+        }
+        if (lane == 0 && row0 + r < nrows) {
+            const float g_val = sum_gate[r];
+            const float silu_g = g_val * (1.0f / (1.0f + expf(-g_val)));
+            dst[row0 + r] = silu_g * sum_up[r];
+        }
+    }
+}
+
+template <int R>
+static void gp100_dispatch_hetero_r(ggml_type type_up, ggml_type type_gate,
+                                    const void * vUp, const void * vGate,
+                                    const half * y, const float2 * ys,
+                                    float * dst, int nrows, int nsb,
+                                    int stride_up, int stride_gate, cudaStream_t stream) {
+    const int nblocks = (nrows + 4*R - 1) / (4*R);
+    if (type_up == GGML_TYPE_IQ4_XS && type_gate == GGML_TYPE_IQ3_S) {
+        gp100_mmvq_glu_iq4xs_iq3s<R><<<nblocks, 128, 0, stream>>>(vUp, vGate, y, ys, dst, nrows, nsb, stride_up, stride_gate);
+    } else if (type_up == GGML_TYPE_IQ3_S && type_gate == GGML_TYPE_IQ4_XS) {
+        gp100_mmvq_glu_iq3s_iq4xs<R><<<nblocks, 128, 0, stream>>>(vUp, vGate, y, ys, dst, nrows, nsb, stride_up, stride_gate);
+    } else if (type_up == GGML_TYPE_Q4_K && type_gate == GGML_TYPE_IQ4_XS) {
+        gp100_mmvq_glu_q4k_iq4xs<R><<<nblocks, 128, 0, stream>>>(vUp, vGate, y, ys, dst, nrows, nsb, stride_up, stride_gate);
+    } else if (type_up == GGML_TYPE_IQ3_S && type_gate == GGML_TYPE_IQ3_XXS) {
+        gp100_mmvq_glu_iq3s_iq3xxs<R><<<nblocks, 128, 0, stream>>>(vUp, vGate, y, ys, dst, nrows, nsb, stride_up, stride_gate);
+    } else {
+        GGML_ABORT("unsupported heterogeneous GLU pair on GP100");
+    }
+}
+
+static void gp100_dispatch_hetero(ggml_type type_up, ggml_type type_gate,
+                                 const void * vUp, const void * vGate,
+                                 const half * y, const float2 * ys,
+                                 float * dst, int nrows, int nsb,
+                                 int stride_up, int stride_gate, cudaStream_t stream) {
+    constexpr int R = 4;
+    gp100_dispatch_hetero_r<R>(type_up, type_gate, vUp, vGate, y, ys, dst, nrows, nsb, stride_up, stride_gate, stream);
+}
