+    }
+
+#pragma unroll
+    for (int r = 0; r < R; r++) {
+#pragma unroll
+        for (int o = 16; o > 0; o >>= 1) {
+            sum_up[r]   += __shfl_xor_sync(0xFFFFFFFF, sum_up[r], o);
+            sum_gate[r] += __shfl_xor_sync(0xFFFFFFFF, sum_gate[r], o);
+        }
+        if (lane == 0 && row0 + r < nrows) {
+            const float g_val = sum_gate[r];
+            const float silu_g = g_val * (1.0f / (1.0f + expf(-g_val)));
+            dst[row0 + r] = silu_g * sum_up[r];
+        }
+    }
