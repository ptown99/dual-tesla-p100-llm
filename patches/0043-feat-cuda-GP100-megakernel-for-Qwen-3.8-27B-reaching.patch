+    const bool     hi_sc = jj >= 2;
+    const uint32_t mA = hi_sc ? 0u : 0x3F3F3F3Fu;
+    const uint32_t mC = hi_sc ? 0x0F0F0F0Fu : 0u;
+    const uint32_t mS = hi_sc ? 0x30303030u : 0u;
+    const uint32_t mH = hf ? 0u : ~0u;
