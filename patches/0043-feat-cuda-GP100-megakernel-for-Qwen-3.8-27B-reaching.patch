+            const half d_val = __ushort_as_half(*((const uint16_t *) (bp + 0)));
+            const uint16_t a0 = *((const uint16_t *) (bp + 66 + 4 * t + 0));
+            const uint16_t a1 = *((const uint16_t *) (bp + 66 + 4 * t + 2));
+            const uint32_t aux32 = (uint32_t) a0 | ((uint32_t) a1 << 16);
