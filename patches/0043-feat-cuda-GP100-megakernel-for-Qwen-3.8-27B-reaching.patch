diff --git a/ggml/src/ggml-cuda/mmvq-gp100-hetero.inc b/ggml/src/ggml-cuda/mmvq-gp100-hetero.inc
new file mode 100644
index 0000000..31cae2a
--- /dev/null
+++ b/ggml/src/ggml-cuda/mmvq-gp100-hetero.inc
@@ -0,0 +1,646 @@
+// Heterogeneous MMVQ GLU kernels for Pascal GP100 (sm_60)
+// Fuses up-projection and gate-projection with differing quantization formats
+// directly into SwiGLU activation in registers without intermediate DRAM traffic.
+
+bool ggml_cuda_gp100_mmvq_hetero_fusable(const ggml_type up, const ggml_type gate) {
+    if (up == GGML_TYPE_IQ4_XS && gate == GGML_TYPE_IQ3_S) return true;
+    if (up == GGML_TYPE_IQ3_S && gate == GGML_TYPE_IQ4_XS) return true;
+    if (up == GGML_TYPE_IQ3_S && gate == GGML_TYPE_IQ3_XXS) return true;
+    return false;
+}
+
+
+// 1. up = IQ4_XS, gate = IQ3_S (with 128-bit coalesced vector loading)
+template <int R>
+static __global__ void __launch_bounds__(128) gp100_mmvq_glu_iq4xs_iq3s(
+        const void * __restrict__ vUp, const void * __restrict__ vGate,
+        const half * __restrict__ y, const float2 * __restrict__ ys,
+        float * __restrict__ dst, const int nrows, const int nsb,
+        const int stride_up, const int stride_gate) {
+    constexpr int U2_PER_BLOCK = sizeof(block_iq4_xs) / sizeof(uint2);
+    constexpr uint32_t T0 = 0x3F2D1801u, T1 = 0x766A5D4Fu, T2 = 0xA6998D81u, T3 = 0xF1D9C5B5u;
+
+    __shared__ uint32_t s_grid[512];
+    for (int i = threadIdx.x; i < 512; i += blockDim.x) {
+        s_grid[i] = iq3s_grid[i];
+    }
+    __shared__ uint4 s_blk[4][4][8];
+    __syncthreads();
+
+    const int lane = threadIdx.x % WARP_SIZE;
+    const int warp = threadIdx.x / WARP_SIZE;
+    const int row0 = (blockIdx.x * (blockDim.x / WARP_SIZE) + warp) * R;
+    const int g = lane / 8;
+    const int t = lane % 8;
+
+    const uint2 * base_up[R];
+    const block_iq3_s * base_gate[R];
+#pragma unroll
+    for (int r = 0; r < R; r++) {
+        const int row = min(row0 + r, nrows - 1);
+        base_up[r]   = (const uint2 *) ((const block_iq4_xs *) vUp + (int64_t) row * stride_up + g);
+        base_gate[r] = (const block_iq3_s *) vGate + (int64_t) row * stride_gate;
+    }
+
+    float sum_up[R];
+    float sum_gate[R];
+#pragma unroll
+    for (int r = 0; r < R; r++) {
+        sum_up[r]   = 0.0f;
+        sum_gate[r] = 0.0f;
+    }
+
+    for (int sb = g; sb < nsb; sb += 4) {
+        const uint4 * yp = (const uint4 *) (y + sb * 256 + 32 * t);
+        const uint4 yv[4] = {__ldg(yp), __ldg(yp + 1), __ldg(yp + 2), __ldg(yp + 3)};
+        const float2 sc = __ldg(ys + sb * 8 + t);
+        const half2 * YL = (const half2 *) &yv[0];
+        const half2 * YH = (const half2 *) &yv[2];
+        const half2 * Y  = (const half2 *) &yv[0];
+
+        // 1. IQ4_XS (up)
+        uint2 hd[R], q0[R], q1[R];
+#pragma unroll
+        for (int r = 0; r < R; r++) {
+            const uint2 * p = base_up[r] + (sb - g) * U2_PER_BLOCK;
+            hd[r] = __ldg(p);
+            q0[r] = __ldg(p + 1 + 2 * t);
+            q1[r] = __ldg(p + 2 + 2 * t);
+        }
+#pragma unroll
+        for (int r = 0; r < R; r++) {
+            half2 acc = __float2half2_rn(0.0f);
+            const uint32_t qw[4] = {q0[r].x, q0[r].y, q1[r].x, q1[r].y};
+#pragma unroll
+            for (int k = 0; k < 4; k++) {
+                const uint32_t q  = qw[k];
+                const uint32_t qx = q ^ 0x88888888u;
+                const uint32_t S  = ((q >> 1) & 0x44444444u) | 0x32103210u;
+                const uint32_t v0 = gp100_prmt(gp100_prmt(T0, T1, q),       gp100_prmt(T2, T3, qx),       S);
+                const uint32_t v1 = gp100_prmt(gp100_prmt(T0, T1, q >> 16), gp100_prmt(T2, T3, qx >> 16), S >> 16);
+                const uint32_t a = __byte_perm(v0, 0, 0x4240);
+                const uint32_t b = __byte_perm(v1, 0, 0x4240);
+                const uint32_t c = __byte_perm(v0, 0, 0x4341);
+                const uint32_t d = __byte_perm(v1, 0, 0x4341);
+                acc = __hfma2(*(const half2 *) &a, YL[2*k + 0], acc);
+                acc = __hfma2(*(const half2 *) &b, YL[2*k + 1], acc);
+                acc = __hfma2(*(const half2 *) &c, YH[2*k + 0], acc);
+                acc = __hfma2(*(const half2 *) &d, YH[2*k + 1], acc);
+            }
+            const int   ls = ((hd[r].y >> (4 * t)) & 0xF) | (((hd[r].x >> (16 + 2 * t)) & 3) << 4);
+            const float dl = __half2float(__ushort_as_half((unsigned short) (hd[r].x & 0xFFFF))) * (float) (ls - 32);
+            const float s  = __half2float(__hadd(__low2half(acc), __high2half(acc)));
+            sum_up[r] += dl * fmaf(s, sc.x, -128.0f * sc.y);
+        }
+
+        // 2. Coalesced IQ3_S (gate)
+#pragma unroll
+        for (int r = 0; r < R; r++) {
+            const uintptr_t b_addr = (uintptr_t)(base_gate[r] + sb);
+            const uintptr_t a_addr = b_addr & ~((uintptr_t) 15);
+            const int offset = (int)(b_addr - a_addr);
+
+            s_blk[warp][g][t] = __ldg((const uint4 *) a_addr + t);
+
+            const uint8_t * bp = ((const uint8_t *) &s_blk[warp][g][0]) + offset;
+
+            const half d_val = __ushort_as_half(*((const uint16_t *) (bp + 0)));
+            const uint8_t sc_byte = *(bp + 106 + (t / 2));
+            const int scale_nibble = (t & 1) ? (sc_byte >> 4) : (sc_byte & 0x0F);
+            const float dl = __half2float(d_val) * (float)(1 + 2 * scale_nibble);
+
+            const uint8_t * qs_b = bp + 2 + 8 * t;
+            const uint8_t qh = *(bp + 66 + t);
+
+            const uint16_t signs_lo = *((const uint16_t *) (bp + 74 + 4 * t + 0));
+            const uint16_t signs_hi = *((const uint16_t *) (bp + 74 + 4 * t + 2));
+            const uint32_t signs32 = (uint32_t) signs_lo | ((uint32_t) signs_hi << 16);
+
+            half2 acc = __float2half2_rn(0.0f);
+#pragma unroll
+            for (int k = 0; k < 8; k++) {
+                const uint32_t grid_idx = qs_b[k] | (((qh >> k) & 1) << 8);
+                const uint32_t grid_val = s_grid[grid_idx];
+                const uint32_t mag0 = __byte_perm(grid_val, 0, 0x4140);
+                const uint32_t mag1 = __byte_perm(grid_val, 0, 0x4342);
+
+                const uint32_t s4 = (signs32 >> (4 * k)) & 0xF;
+                const uint32_t s_mask0 = ((s4 & 1) << 15) | ((s4 & 2) << 30);
+                const uint32_t s_mask1 = ((s4 & 4) << 13) | ((s4 & 8) << 28);
+
+                const uint32_t p0 = mag0 | s_mask0;
+                const uint32_t p1 = mag1 | s_mask1;
+
+                acc = __hfma2(*(const half2 *)&p0, Y[2 * k + 0], acc);
+                acc = __hfma2(*(const half2 *)&p1, Y[2 * k + 1], acc);
+            }
+
+            const float s = __half2float(__hadd(__low2half(acc), __high2half(acc)));
