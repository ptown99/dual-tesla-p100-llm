+                acc = __hfma2(*(const half2 *) &b, YL_xs[2*k + 1], acc);
+                acc = __hfma2(*(const half2 *) &c, YH_xs[2*k + 0], acc);
+                acc = __hfma2(*(const half2 *) &d, YH_xs[2*k + 1], acc);
+            }
+            const int   ls = ((hd_xs[r].y >> (4 * t)) & 0xF) | (((hd_xs[r].x >> (16 + 2 * t)) & 3) << 4);
