From 1c066980d2f8e8fbdf2e0bd316670e4d852fe7cd Mon Sep 17 00:00:00 2001
From: builder <builder@localhost>
Date: Sat, 7 Nov 2026 22:57:59 +0000
Subject: [PATCH 38/45] feat(cuda): implement Approach 1 mixed-precision
 storage for Pascal sm_60 (half2 smem + FP32 ALU fma)

---
 ggml/src/ggml-cuda/common.cuh         | 8 ++++----
 ggml/src/ggml-cuda/fattn-tile.cuh     | 4 ++--
 ggml/src/ggml-cuda/mmq-load-tiles.cuh | 2 +-
 ggml/src/ggml-cuda/vecdotq.cuh        | 6 +++---
 4 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/ggml/src/ggml-cuda/common.cuh b/ggml/src/ggml-cuda/common.cuh
index f4fe2c3..1e4ba5b 100644
--- a/ggml/src/ggml-cuda/common.cuh
+++ b/ggml/src/ggml-cuda/common.cuh
@@ -258,7 +258,7 @@ static const char * cu_get_error_str(CUresult err) {
 #define FP16_AVAILABLE
 #endif // defined(GGML_USE_HIP) || defined(GGML_USE_MUSA) || __CUDA_ARCH__ >= GGML_CUDA_CC_PASCAL
 
-#if defined(FP16_AVAILABLE) && __CUDA_ARCH__ != 600 && __CUDA_ARCH__ != 610
+#if defined(FP16_AVAILABLE) && __CUDA_ARCH__ != 610
 #define FAST_FP16_AVAILABLE
 #endif // defined(FP16_AVAILABLE) && __CUDA_ARCH__ != 610
 
@@ -770,14 +770,14 @@ static __device__ __forceinline__ void ggml_cuda_mad(float & acc, const half2 v,
 #ifdef V_DOT2_F32_F16_AVAILABLE
     asm volatile("v_dot2_f32_f16 %0, %1, %2, %0" : "+v"(acc) : "v"(v), "v"(u));
 #else
-#ifdef FAST_FP16_AVAILABLE
+#if defined(FAST_FP16_AVAILABLE) && __CUDA_ARCH__ != 600
     const float2 tmp = __half22float2(v*u);
     acc += tmp.x + tmp.y;
 #else
+    // Pascal sm_60 Approach 1: Mixed-precision storage (half2 tiles) + FP32 FMA computation
     const float2 tmpv = __half22float2(v);
     const float2 tmpu = __half22float2(u);
-    acc += tmpv.x * tmpu.x;
-    acc += tmpv.y * tmpu.y;
+    acc = fmaf(tmpv.x, tmpu.x, fmaf(tmpv.y, tmpu.y, acc));
 #endif // FAST_FP16_AVAILABLE
 #endif // V_DOT2_F32_F16_AVAILABLE
 }
diff --git a/ggml/src/ggml-cuda/fattn-tile.cuh b/ggml/src/ggml-cuda/fattn-tile.cuh
index 7c3e03b..a78ac33 100644
--- a/ggml/src/ggml-cuda/fattn-tile.cuh
+++ b/ggml/src/ggml-cuda/fattn-tile.cuh
@@ -813,7 +813,7 @@ static __device__ __forceinline__ void flash_attn_tile_iter(
         for (int i_KQ_0 = 0; i_KQ_0 < nbatch_fa; i_KQ_0 += np*warp_size) {
             const int i_KQ = i_KQ_0 + (threadIdx.y % np)*warp_size + threadIdx.x;
 
-#if defined(FAST_FP16_AVAILABLE) && !defined(V_DOT2_F32_F16_AVAILABLE)
+#if defined(FAST_FP16_AVAILABLE) && !defined(V_DOT2_F32_F16_AVAILABLE) && __CUDA_ARCH__ != 600
             // Without the v_dot2_f32_f16 instruction there is a higher risk of numerical overflow in the KQ calculation.
             // Therefore, scale down Q values and apply the inverse scale the FP32 KQ values afterwards again.
             KQ_acc[i_KQ_0/(np*warp_size)*cpw + jc0] *= 4.0f;
@@ -1158,7 +1158,7 @@ static __global__ void flash_attn_tile(
 #pragma unroll
                 for (int i1 = 0; i1 < cpy_ne_D; i1 += 2) {
                     tmp_h2[i1/2] = make_half2(tmp_f[i1 + 0], tmp_f[i1 + 1]);
-#if defined(FAST_FP16_AVAILABLE) && !defined(V_DOT2_F32_F16_AVAILABLE)
+#if defined(FAST_FP16_AVAILABLE) && !defined(V_DOT2_F32_F16_AVAILABLE) && __CUDA_ARCH__ != 600
                     // Without the v_dot2_f32_f16 instruction there is a higher risk of numerical overflow in the KQ calculation.
                     // Therefore, scale down Q values and apply the inverse scale the FP32 KQ values afterwards again.
                     tmp_h2[i1/2] *= make_half2(0.25f, 0.25f);
diff --git a/ggml/src/ggml-cuda/mmq-load-tiles.cuh b/ggml/src/ggml-cuda/mmq-load-tiles.cuh
index 8ed704c..b2de86d 100644
--- a/ggml/src/ggml-cuda/mmq-load-tiles.cuh
+++ b/ggml/src/ggml-cuda/mmq-load-tiles.cuh
@@ -572,7 +572,7 @@ template <ggml_type type, int J, bool fallback> static __device__ __forceinline_
         }
 
         const int sc_m = bxi->scales[kqsx];
-#ifdef FAST_FP16_AVAILABLE
+#if defined(FAST_FP16_AVAILABLE) && __CUDA_ARCH__ != 600
         const half2 x_dm_ik = __hmul2(bxi->dm, make_half2(sc_m & 0x0F, sc_m >> 4));
 #else
         const float2 bxi_dmf = __half22float2(bxi->dm);
diff --git a/ggml/src/ggml-cuda/vecdotq.cuh b/ggml/src/ggml-cuda/vecdotq.cuh
index 5ae878f..deccbdd 100644
--- a/ggml/src/ggml-cuda/vecdotq.cuh
+++ b/ggml/src/ggml-cuda/vecdotq.cuh
@@ -154,7 +154,7 @@ template <int vdr> static __device__ __forceinline__ float vec_dot_q4_1_q8_1_imp
         sumi = ggml_cuda_dp4a(vi1, u[2*i+1], sumi);
     }
 
-#ifdef FAST_FP16_AVAILABLE
+#if defined(FAST_FP16_AVAILABLE) && __CUDA_ARCH__ != 600
     const float2 tmp = __half22float2(__hmul2(dm4, ds8));
     const float d4d8 = tmp.x;
     const float m4s8 = tmp.y;
@@ -225,7 +225,7 @@ template <int vdr> static __device__ __forceinline__ float vec_dot_q5_1_q8_1_imp
         sumi = ggml_cuda_dp4a(vi1, u[2*i+1], sumi); // SIMD dot product of quantized values
     }
 
-#ifdef FAST_FP16_AVAILABLE
+#if defined(FAST_FP16_AVAILABLE) && __CUDA_ARCH__ != 600
     const float2 tmp = __half22float2(__hmul2(dm5, ds8));
     const float d5d8 = tmp.x;
     const float m5s8 = tmp.y;
@@ -268,7 +268,7 @@ template <int vdr> static __device__ __forceinline__ float vec_dot_q8_1_q8_1_imp
         sumi = ggml_cuda_dp4a(v[i], u[i], sumi);
     }
 
-#ifdef FAST_FP16_AVAILABLE
+#if defined(FAST_FP16_AVAILABLE) && __CUDA_ARCH__ != 600
     const float2 tmp = __half22float2(__hmul2(dm8, ds8));
     const float d8d8 = tmp.x;
     const float m8s8 = tmp.y;
-- 
